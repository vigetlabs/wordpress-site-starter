# Third-party code we ship rather than write. Collapsed in pull request diffs and
# excluded from the repo's language stats.
#
# ACF Pro is committed on purpose so the starter runs with no license key. A real
# project swaps it for the Composer package once it has one, and deletes this
# directory - see "Licensed plugins" in the README.
wp-content/plugins/advanced-custom-fields-pro/** linguist-vendored=true

# Generated output.
#
# theme.json is built from the Tailwind config by a Vite plugin on every build.
# Tailwind is the source of truth; this file is an artifact.
wp-content/themes/wp-starter/theme.json linguist-generated=true

# Regenerated by wp i18n make-pot.
wp-content/mu-plugins/viget-wp/languages/*.pot linguist-generated=true
