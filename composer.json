{
  "name": "viget/wordpress-site-starter",
  "description": "A custom WordPress Site Starter Kit by Viget.",
  "keywords": [
    "wordpress",
    "components",
    "boilerplate",
    "cms",
    "ddev",
    "tailwind",
    "vite"
  ],
  "type": "project",
  "homepage": "https://github.com/vigetlabs/wordpress-site-starter",
  "license": "MIT",
  "authors": [
    {
      "name": "Viget",
      "homepage": "https://viget.com/"
    }
  ],
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "composer/installers": true,
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "autoload": {
    "psr-4": {
      "Viget\\ComposerScripts\\": "bin/composer-scripts/"
    }
  },
  "scripts": {
    "post-create-project-cmd": [
      "Viget\\ComposerScripts\\ProjectEventHandler::postCreateProject",
      "ddev start"
    ],
    "sync-version": "node bin/sync-version.mjs",
    "test": [
      "phpunit"
    ]
  },
  "require-dev": {
    "composer/composer": "^2.10",
    "phpunit/phpunit": "^11.5",
    "symfony/console": "^8.1"
  },
  "autoload-dev": {
    "psr-4": {
      "Viget\\ComposerScripts\\Tests\\": "tests/"
    }
  }
}
