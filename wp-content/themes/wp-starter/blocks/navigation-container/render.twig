{#
	Block: Navigation Container
#}

{% set allowed = [
	'acf/navigation-toggle',
	'acf/navigation-content',
	'core/group',
	'core/site-logo',
	'core/search',
] %}
{% set inner = {
	template: block.template ?? [],
	allowedBlocks: allowed
} %}
{% set attrs = {} %}

{% if function('is_admin') == false %}
	{% set attrs = {
		'x-data': '{menuIsOpen : false}',
		'x-id': "['navigation-content']",
		'x-trap': 'menuIsOpen',
		'@keydown.escape': 'menuIsOpen = false'
	} %}
{% endif %}

<div {{ block_attrs( block, '', attrs ) }}>
	{{ inner_blocks( inner ) }}
</div>
